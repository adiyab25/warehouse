# --- Database -------------------------------------------------------------
# Two roles on purpose — they must not be the same one.
#
# OWNER (superuser): runs migrations (`npm run db:migrate` / `npm run db:reset`).
# Whoever creates a table owns it, and a table's OWNER bypasses that table's own
# RLS policies — so the runner must connect as the owner, never as a test role.
#   MIGRATE_DATABASE_URL wins if set; DATABASE_URL is the fallback the runner
#   and the tests' `migrateUrl()` read.
MIGRATE_DATABASE_URL="postgresql://postgres@127.0.0.1:55499/warehouse"
DATABASE_URL="postgresql://postgres@127.0.0.1:55499/warehouse"

# TEST (non-superuser `authenticated`): every test connects as this role.
# It does not own the tables, so RLS applies to it and a tenancy test proves
# something; run as the owner it would pass trivially. Never put a superuser
# (or `postgres`) here. A test that points the migration runner at this url is
# exactly the bug the ownership regression test guards against.
SQL_TEST_DATABASE_URL="postgresql://authenticated@127.0.0.1:55499/warehouse"
