# --- Database -------------------------------------------------------------
# Where `npm run db:migrate` applies migrations. On a development machine this
# may be the cluster owner; in production it is Supabase's Postgres.
DATABASE_URL="postgresql://postgres@127.0.0.1:55499/warehouse"

# The connection every test uses. It MUST be the non-superuser role
# `authenticated` — a superuser bypasses row-level security, so a tenancy test
# run as `postgres` proves nothing at all. Never put a superuser here.
SQL_TEST_DATABASE_URL="postgresql://authenticated@127.0.0.1:55499/warehouse"
